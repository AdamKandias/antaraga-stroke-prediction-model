# --- Database (semua data: users, profiles, log prediksi) ---
# Default kalau tidak diisi: SQLite lokal (sqlite:///./antaraga.db), sudah cukup
# untuk development. Ganti ke Postgres lokal/cloud kalau perlu skala lebih besar.
# DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/antaraga
DATABASE_URL=sqlite:///./antaraga.db

# --- Dev mode ---
# true  -> simulator hardware otomatis jalan (lihat api/simulator.py), dan
#          endpoint /predict & /assessment bisa dipanggil tanpa Authorization
#          header (dianggap "dev-user") supaya gampang dites lewat curl/dashboard.
# false -> wajib kirim Bearer token yang valid (dari /auth/login), simulator tidak jalan.
DEV_MODE=true

# --- Auth (auth kita sendiri, bukan pihak ketiga) ---
# Secret untuk menandatangani access token dari /auth/register & /auth/login.
# Generate sendiri: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# WAJIB diganti ke nilai random sebelum production.
JWT_SECRET=ganti-dengan-random-string-panjang
JWT_EXPIRE_DAYS=30

# Interval simulator hardware dalam mode dev (detik)
SIMULATOR_INTERVAL_SECONDS=20
