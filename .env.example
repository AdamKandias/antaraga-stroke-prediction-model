# --- Database ---
# Development (lokal):
DATABASE_URL=sqlite:///./antaraga.db
# Production (VPS - SQLite di dalam Docker volume):
# DATABASE_URL=sqlite:////app/data/antaraga.db

# --- Dev mode ---
# true  -> simulator hardware otomatis jalan (lihat api/simulator.py), dan
#          endpoint /predict & /assessment bisa dipanggil tanpa Authorization
#          header (dianggap "dev-user") supaya gampang dites lewat curl/dashboard.
# false -> wajib kirim Bearer token yang valid (dari /auth/login), simulator tidak jalan.
DEV_MODE=false

# --- Auth (auth kita sendiri, bukan pihak ketiga) ---
# Secret untuk menandatangani access token dari /auth/register & /auth/login.
# WAJIB diganti ke nilai random sebelum production (siapa pun yang tahu ini
# bisa membuat token palsu untuk user manapun).
JWT_SECRET=XxHGLQybX9_I9-R_G3JdBJVfJS7MAwOOGwXVGO-EX6UUnqdNo82F4MMMg69ZSu4h
JWT_EXPIRE_DAYS=9999

# --- Login dashboard web (/dashboard) ---
# Satu akun operator untuk tim riset, terpisah dari tabel users milik mobile app.
# Masuk lewat /login (URL ini sengaja tidak ditautkan dari halaman mana pun dan
# tidak muncul di /docs).
# WAJIB diganti sebelum server bisa diakses publik - nilai default ada di repo.
DASHBOARD_EMAIL=antaraga@gmail.com
DASHBOARD_PASSWORD=password
# Penanda tangan cookie sesi; kalau kosong ikut JWT_SECRET.
# Menggantinya = semua sesi dashboard yang sedang berjalan langsung logout.
DASHBOARD_SESSION_SECRET=
DASHBOARD_SESSION_DAYS=7

# Interval simulator hardware dalam mode dev (detik)
SIMULATOR_INTERVAL_SECONDS=3

# --- Firebase Cloud Messaging ---
# Path ke service account JSON dari Firebase Console:
#   Project Settings → Service accounts → Generate new private key
# Simpan file-nya di api/serviceAccountKey.json (sudah di .gitignore)
# Kalau kosong/file tidak ada, push notification dinonaktifkan tapi app tetap jalan.
FCM_SERVICE_ACCOUNT_PATH=api/serviceAccountKey.json

# Alternatif untuk peladen: isi kunci layanan ditanam langsung di sini sebagai
# base64, sehingga tidak perlu ada berkas kunci di dalam image maupun di repo.
# Nilainya bertahan melewati git pull dan pembangunan ulang container, karena
# hanya ada di .env.production milik peladen.
#
# Cara membuat nilainya:
#   base64 -w0 serviceAccountKey.json     (Linux)
#   base64 -i serviceAccountKey.json | tr -d '\n'   (macOS)
#
# Bila diisi, berkas pada FCM_SERVICE_ACCOUNT_PATH tidak lagi dilihat.
FCM_SERVICE_ACCOUNT_B64=

# Jeda minimum (detik) antar notifikasi HIGH-risk per user (default 5 menit)
FCM_NOTIFICATION_COOLDOWN_SECONDS=60

# Kunci statis untuk firmware (XIAO ESP32-S3). Isi di config.h:
#   #define CLOUD_API_KEY "antaraga-hw-2025"
# Tidak expire, tapi ganti kalau perangkat hilang/diganti.
DEVICE_INGEST_KEY=antaraga-hw-2026-01
